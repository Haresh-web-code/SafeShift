APP_NAME=SafeShift
ENVIRONMENT=local
# Replace every placeholder before use. Never commit the real .env file.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-enabled-model-name
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=900
GEMINI_DEADLINE_MS=1700
GEMINI_MAX_RETRIES=1
GEMINI_INPUT_COST_PER_MILLION_USD=
GEMINI_OUTPUT_COST_PER_MILLION_USD=

POSTGRES_USER=safeshift
POSTGRES_DB=safeshift
